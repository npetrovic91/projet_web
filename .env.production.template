# ============================================================
# AUTOSAV — Configuration de production
# ============================================================
# IMPORTANT : Ce fichier contient des SECRETS.
#   - Ne jamais le committer dans Git (.env est dans .gitignore)
#   - Ne jamais le partager par email ou messagerie
#   - Le stocker dans un gestionnaire de secrets (Bitwarden, 1Password, etc.)
#   - Permissions fichier recommandées : chmod 640 .env
# ============================================================

# ── APPLICATION ──────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_URL=https://devnenad.fr
APP_TIMEZONE=Europe/Paris

# ── BASE DE DONNÉES ───────────────────────────────────────────
# Hostinger : voir hPanel → Bases de données → MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u166513890_base
DB_USERNAME=u166513890_base
DB_PASSWORD=REMPLACER_MOT_DE_PASSE_BDD
# Alias rétrocompatibles (ne pas supprimer)
DB_NAME=u166513890_base
DB_USER=u166513890_base
DB_PASS=REMPLACER_MOT_DE_PASSE_BDD
DB_CHARSET=utf8mb4

# ── MESSAGERIE SMTP ───────────────────────────────────────────
# Générer les identifiants SMTP depuis le panel de votre fournisseur email
MAIL_HOST=smtp.votre-fournisseur.tld
MAIL_PORT=587
MAIL_USERNAME=no-reply@devnenad.fr
MAIL_PASSWORD=REMPLACER_MOT_DE_PASSE_SMTP
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@devnenad.fr
MAIL_FROM_NAME="AUTOSAV"
MAIL_REPLY_TO=support@devnenad.fr
# IMPORTANT : passer à false une fois le SMTP testé et validé
MAIL_SANDBOX=false
MAIL_SANDBOX_TO=
MAIL_FAIL_IF_UNCONFIGURED=true

# ── SECURITE ─────────────────────────────────────────────────
# Générer avec : php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
ENCRYPTION_KEY=base64:REMPLACER_PAR_CLE_GENEREE_32_OCTETS

ENCRYPTION_CIPHER=aes-256-cbc

# Proxies de confiance (Cloudflare, reverse proxy, load balancer)
# Laisser vide si aucun reverse proxy
# Exemple : TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22
TRUSTED_PROXIES=

# En-têtes proxy acceptées (dans l'ordre de priorité)
TRUSTED_PROXY_HEADERS=HTTP_CF_CONNECTING_IP,HTTP_X_FORWARDED_FOR,HTTP_X_REAL_IP

# ── SESSION ───────────────────────────────────────────────────
SESSION_NAME=AUTOSAV_SESSION
SESSION_LIFETIME_MINUTES=30
SESSION_REGENERATE_MINUTES=10

# ── MAINTENANCE ───────────────────────────────────────────────
APP_FORCE_HTTPS=true

# ── SAUVEGARDES ──────────────────────────────────────────────
BACKUP_DIR=storage/backups
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESS=true
MYSQLDUMP_BINARY=mysqldump

# ── HEALTH CHECK ─────────────────────────────────────────────
# Générer avec : php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
HEALTHCHECK_PUBLIC=false
HEALTHCHECK_TOKEN=REMPLACER_TOKEN_HEALTHCHECK_64_CHARS

# ── MONITORING ────────────────────────────────────────────────
MONITOR_ALERT_EMAIL=admin@devnenad.fr

# ── BINAIRES ─────────────────────────────────────────────────
# Adapter selon la version PHP disponible sur l'hébergeur
# Sur Hostinger : php8.2 ou /usr/bin/php8.2
PHP_BINARY_PATH=php8.2
MYSQL_BINARY=mysql

# ── RATE LIMITING ─────────────────────────────────────────────
AJAX_RATE_LIMIT_ENABLED=true
AJAX_RATE_LIMIT_MAX_REQUESTS=60
AJAX_RATE_LIMIT_WINDOW_SECONDS=60
