Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Activer seulement si HTTPS est bien configuré côté hébergeur/proxy.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Protection des fichiers et dossiers sensibles.
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(?:composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml(?:\.dist)?|README(?:\.md)?|DEPLOY(?:\.md)?|\.env(?:\..*)?|.*\.(?:sql|log|zip|tar|gz|bak|backup|old|orig|ini|phar|sh|cmd|bat|ps1))$ - [F,L,NC]
    RewriteRule ^(?:Core|Modules|config|vendor|storage|database|tests|docs|deploy|bin)(?:/|$) - [F,L,NC]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "(^\.|composer\.(json|lock)$|phpunit\.xml|\.env|\.(ini|sql|log|zip|tar|gz|bak|backup|old|orig|phar|sh|cmd|bat|ps1)$)">
    Require all denied
</FilesMatch>

# N'autorise pas l'exécution directe de fichiers PHP hors front-controller et healthcheck.
<FilesMatch "^(?!index\.php$|health\.php$).+\.php$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/css text/xml application/json application/javascript application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
</IfModule>
